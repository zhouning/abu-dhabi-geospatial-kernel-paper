# The minimal public-data bundle is versioned so a clean checkout can run the
# benchmark.  Only regenerable intermediates and the large raw OSM download
# remain ignored.
benchmarks/abu_dhabi_land_use_v1/artifacts/gee/alphaearth/chunks/
benchmarks/abu_dhabi_land_use_v1/artifacts/osm/*.pbf
benchmarks/abu_dhabi_land_use_v1/artifacts/*/work/
benchmarks/abu_dhabi_land_use_v1/artifacts/mechanism_ablations/
benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/*
!benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/
benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/report.json
benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/ensemble/
!benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/seed_*/
benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/seed_*/prediction_*.tif
!benchmarks/abu_dhabi_land_use_v1/artifacts/predictions/paper58/seed_*/paper58_ldn.pt
benchmarks/abu_dhabi_land_use_v1/artifacts/predictions_current/
benchmarks/abu_dhabi_land_use_v1/artifacts/planning_public_2025_2031/
benchmarks/abu_dhabi_land_use_v1/artifacts/planning/
