benchmarks/abu_dhabi_land_use_v1/artifacts/predictions_current/
benchmarks/abu_dhabi_land_use_v1/figures/

# V2 archives immutable inputs, published reports and delivery artefacts. These
# per-run training/simulation workspaces are regenerated by the v2 rerun entry
# point and are intentionally excluded from the DOI release baseline.
